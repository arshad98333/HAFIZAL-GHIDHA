# MongoDB Atlas — the logbook of record. Use a database user with a role
# scoped to MONGODB_DB_NAME only (Atlas custom role, readWrite on that one
# database) — the golden set lives in a separate database with no grant to
# this user at all. Never put a real password in this file; put it only in
# your local, untracked .env. If a credential was ever pasted into a chat
# or committed by mistake, rotate it in Atlas immediately.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB_NAME=cold_chain

# Azure OpenAI — gpt-5.4-mini. Auth is AAD (DefaultAzureCredential); no API
# key is read from this file, only the endpoint and deployment names. This is
# the single external model provider in this pipeline: the same deployment
# renders, screens, extracts, and (at low concurrency, distinct temperature)
# judges for the agentic review board and Gate B.
AZURE_OPENAI_ENDPOINT=https://your-endpoint.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_MAX_CONCURRENCY=8

# Self-consistency voting for the agentic review board / Gate B judge calls.
JUDGE_VOTES=5
JUDGE_AGREEMENT_FLOOR=0.6

# K2-Think-v2 (MBZUAI, UAE sovereign model) — powers the compliance Q&A chat
# only (/compliance/ask, the "Ask" page in the UI). Not part of the training
# pipeline's render/screen/judge path (see TESTING_REPORT_azure_review_migration.md
# for why K2 was removed from that path previously — this is a separate, new use).
# Optional: leave K2_API_KEY blank and the chat reports itself unavailable (503)
# rather than the API failing to start. Verify your deployment target (e.g. the
# Azure Container App) actually has network egress to api.k2think.ai before
# relying on this in production — that was the failure mode last time.
K2_API_KEY=
K2_BASE_URL=https://api.k2think.ai/v1
K2_MODEL=MBZUAI-IFM/K2-Think-v2
K2_MAX_CONCURRENCY=4

# Azure AI Content Safety (optional — screening stage skips if unset)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# Managed training compute (student SFT). Cloud-agnostic: fill in whatever
# region and base checkpoint this deployment actually targets -- neither is
# hardcoded or validated by the pipeline.
FOUNDRY_PROJECT_ENDPOINT=https://your-endpoint.services.ai.azure.com/api/projects/proj-default
FOUNDRY_COMPUTE_CLUSTER=<gpu-cluster-name>
FOUNDRY_BASE_MODEL=<org/base-model-checkpoint>
TRAINING_REGION=<azure-region>

# Deployed fine-tuned checkpoint, used only by the automated Gate B to have
# something to score. Leave blank until a wave's checkpoint is deployed.
STUDENT_INFERENCE_ENDPOINT=
STUDENT_INFERENCE_KEY=

# Knowledge base + guardrails (GCC food-law corpus, shipped with the repo).
# Only override for a non-standard checkout layout.
KNOWLEDGE_BASE_DIR=./gcc_food_law_json
GUARDRAILS_DIR=./guardrails

# 5,304 records across 8 waves of 663 (CURRICULUM.md section 1). Override for
# a reduced-scale dry run without touching curriculum.py.
WAVE_SIZE=663
CELL_TARGET=265

LOG_LEVEL=INFO
ENVIRONMENT=production
