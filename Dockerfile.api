# FastAPI HTTP server image (Azure Container Apps — scale-to-zero)
FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY cold_chain/ cold_chain/
COPY gcc_food_law_json/ gcc_food_law_json/
COPY guardrails/ guardrails/
COPY scripts/ scripts/

ENV PYTHONUNBUFFERED=1
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "cold_chain.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
